@using System.Security.Principal
@using NSE.WebApp.MVC.Extensions
@inject IUser AppUser

<ul class="navbar-nav">
    @if (AppUser.IsAuthenticated())
    {
        <li class="nav-item">
            <span class="nav-link text-dark">Olá @AppUser.GetUserEmail()</span>
        </li>

        <li class="nav-item">
            Logout
        </li>
    }
    else
    {

        <li class="nav-item me-1">
            <a class="btn btn-outline-success" asp-controller="Auth" asp-action="Register">
                Registrar
            </a>
        </li>
        <li class="nav-item">
            <a class="btn btn-outline-primary" asp-controller="Auth" asp-action="Login">
                Login
            </a>
        </li>
    }
</ul>